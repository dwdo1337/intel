{
  "name": "intel-command-deck",
  "version": "0.3.3",
  "description": "Standalone memecoin signal command deck for Telegram, Discord and DEX data.",
  "author": "intel.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "open": "node -e \"const u='http://localhost:5050';require('child_process').exec((process.platform==='win32'?'start \"\" ':process.platform==='darwin'?'open ':'xdg-open ')+u)\""
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gmgn-cli": "^1.5.6",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
